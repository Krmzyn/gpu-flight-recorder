{
  "sample_interval_sec": 2.0,
  "heartbeat_interval_sec": 1.0,
  "keyboard_interval_sec": 0.5,
  "display_interval_sec": 1.0,
  "gpu_probe_interval_sec": 2.0,
  "process_interval_sec": 10.0,
  "event_interval_sec": 30.0,
  "log_dir": "%USERPROFILE%\\Documents\\GPUFlightRecorder\\logs",
  "nvidia_smi_path": null,
  "nvidia_smi_timeout_sec": 1.0,
  "startup_event_scan_minutes": 30,
  "startup_event_history_days": 30,
  "collector_health_interval_sec": 60.0,
  "prompt_enable_optional_event_channels": true,
  "admin_relaunch_prompt": true,
  "freeze_classifier_warmup_seconds": 60.0,
  "freeze_classifier_strong_failure_ms": 5000.0,
  "freeze_classifier_minor_failure_ms": 1500.0,
  "freeze_classifier_cluster_window_sec": 30.0,
  "freeze_classifier_cluster_min_failures": 3,
  "freeze_classifier_cluster_total_ms": 5000.0,
  "support_bundle_minutes": 10,
  "command_line_capture": false,
  "generate_reports_automatically": true,
  "fsync_each_write": true,
  "target_processes": [
    "blender.exe",
    "fusion360.exe",
    "adskfusion360.exe",
    "fusionlauncher.exe",
    "claude.exe",
    "code.exe",
    "cursor.exe",
    "chrome.exe",
    "nvidia container.exe",
    "nvcontainer.exe",
    "dwm.exe",
    "explorer.exe"
  ],
  "event_keywords": [
    "Display",
    "nvlddmkm",
    "NVIDIA",
    "LiveKernelEvent",
    "WHEA",
    "WHEA-Logger",
    "Kernel-Power",
    "Desktop Window Manager",
    "dwm",
    "dwm.exe",
    "TDR",
    "WATCHDOG",
    "hardware error",
    "device reset",
    "display driver",
    "stopped responding",
    "recovered",
    "BugCheck"
  ],
  "event_logs": [
    "System",
    "Application",
    "Microsoft-Windows-WerKernel/Operational",
    "Microsoft-Windows-Kernel-WHEA/Errors",
    "Microsoft-Windows-Kernel-Power/Thermal-Operational",
    "Microsoft-Windows-Kernel-PnP/Driver Watchdog",
    "Microsoft-Windows-Dwm-Core/Operational",
    "Microsoft-Windows-DxgKrnl/Operational",
    "Microsoft-Windows-Diagnostics-Performance/Operational"
  ],
  "live_kernel_paths": [
    "C:\\Windows\\LiveKernelReports",
    "C:\\Windows\\LiveKernelReports\\WATCHDOG",
    "C:\\Windows\\Minidump"
  ]
}
