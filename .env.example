# GPU Flight Recorder - environment variables
#
# This tool reads real process environment variables. It does NOT auto-load this
# file (there is no python-dotenv dependency). Treat this file as documentation,
# and set the variable in your own shell/session if you want to use it.
#
# GPU_FLIGHT_RECORDER_CONFIG
#   Absolute path to a config.json to load instead of the default search order.
#   If unset, the app looks for ./config.json, then
#   %USERPROFILE%\Documents\GPUFlightRecorder\config.json.
#
#   Example (PowerShell, current session only):
#     $env:GPU_FLIGHT_RECORDER_CONFIG = "C:\Users\You\gpu-fr-config.json"
#
GPU_FLIGHT_RECORDER_CONFIG=
